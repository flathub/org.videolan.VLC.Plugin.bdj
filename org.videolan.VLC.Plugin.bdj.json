{
  "id": "org.videolan.VLC.Plugin.bdj",
  "build-extension": true,
  "runtime": "org.videolan.VLC",
  "runtime-version": "stable",
  "branch": "3-25.08",
  "sdk": "org.freedesktop.Sdk//25.08",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.openjdk17"],
  "build-options": {
    "env": {
      "V": "1",
      "JAVA_HOME": "/usr/lib/sdk/openjdk17"
    },
    "append-path": "/usr/lib/sdk/openjdk17/bin"
  },
  "modules": [
    {
      "name": "openjdk",
        "buildsystem": "simple",
        "build-commands": [
          "mkdir -p /app/share/vlc/extra/bdj/jre/bin",
          "cp -ra /usr/lib/sdk/openjdk17/jvm/openjdk-17/{conf,lib,release} /app/share/vlc/extra/bdj/jre/",
          "rm /app/share/vlc/extra/bdj/jre/lib/src.zip /app/share/vlc/extra/bdj/jre/lib/ct.sym",
          "cp -ra /usr/lib/sdk/openjdk17/jvm/openjdk-17/bin/{java,keytool,rmiregistry} /app/share/vlc/extra/bdj/jre/bin"
        ]
    },
    {
      "name": "ant",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/share/vlc/extra/bdj/ant",
        "tar xf apache-ant-bin.tar.bz2 --strip-components=1 --directory=/app/share/vlc/extra/bdj/ant"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://dlcdn.apache.org/ant/binaries/apache-ant-1.10.18-bin.tar.bz2",
          "dest-filename": "apache-ant-bin.tar.bz2",
          "sha256": "bc12be70cb5c1b074c1e73d82a3f3da55f3c65b8a0c7342a6eb6d1d024265280"
        }
      ]
    },
    {
      "name": "libbluray",
      "buildsystem": "meson",
      "config-opts": ["-Dfontconfig=enabled", "-Dfreetype=enabled", "-Dlibxml2=enabled", "--prefix=/app/share/vlc/extra/bdj", "--libdir=/app/share/vlc/extra/bdj/lib"],
      "build-options": {
        "append-path": "/app/share/vlc/extra/bdj/ant/bin"
      },
      "sources": [
        {
          "type": "archive",
          "url": "https://downloads.videolan.org/pub/videolan/libbluray/1.5.0/libbluray-1.5.0.tar.xz",
          "sha256": "f676408e91a5d321abf8b8d4dfdae36205c297dab5c54c3ec519639025f474a2"
        }
      ]
    },
    {
      "name": "envvars",
      "buildsystem": "simple",
      "build-commands": [
        "mv bdj-env.sh /app/share/vlc/extra/bdj",
        "rm -rf /app/share/vlc/extra/bdj/ant",
        "install -Dm644 --target-directory=${FLATPAK_DEST}/share/metainfo org.videolan.VLC.Plugin.bdj.metainfo.xml"
      ],
      "sources": [
        {
          "type": "file",
          "path": "bdj-env.sh"
        },
        {
          "type": "file",
          "path": "org.videolan.VLC.Plugin.bdj.metainfo.xml"
        }
      ]
    }
  ]
}
